{
  "name": "ftg-refs-codelens",
  "displayName": "FTG Toolkit",
  "description": "FTG syntax highlighting, references, definitions and inline hints",
  "version": "0.3.9",
  "publisher": "local",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ftg",
        "aliases": [
          "FTG",
          "For The Glory"
        ],
        "extensions": [
          ".eue",
          ".inc",
          ".eug"
        ],
        "configuration": "./language-configuration/ftg.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ftg",
        "scopeName": "source.ftg",
        "path": "./syntaxes/ftg.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "ftgRefs.showReferences",
        "title": "FTG: Show References"
      },
      {
        "command": "ftgRefs.showReferencesFromCursor",
        "title": "FTG: Show References from Cursor"
      },
      {
        "command": "ftgRefs.goToDefinitionFromCursor",
        "title": "FTG: Go to Definition from Cursor"
      },
      {
        "command": "ftgRefs.localizeEventFromCursor",
        "title": "FTG: Localize Current Event"
      },
      {
        "command": "ftgRefs.localizeDecisionFromCursor",
        "title": "FTG: Localize Current Decision"
      },
      {
        "command": "ftgRefs.insertProvinceIdFromCascade",
        "title": "FTG: Insert Province ID (Cascade Picker)"
      },
      {
        "command": "ftgRefs.jumpBetweenSourceAndLocalization",
        "title": "FTG: Jump Source <-> Localization"
      },
      {
        "command": "ftgRefs.formatDocument",
        "title": "FTG: Format Document (expand blocks)"
      },
      {
        "command": "ftgRefs.scanAllProblems",
        "title": "FTG: Scan Problems (Events + Decisions ? clipboard)"
      },
      {
        "command": "ftgRefs.createWorkspace",
        "title": "FTG: Create Workspace for Mod"
      }
    ],
    "keybindings": [
      {
        "command": "ftgRefs.localizeEventFromCursor",
        "key": "ctrl+alt+shift+l",
        "when": "editorTextFocus && editorLangId == ftg"
      },
      {
        "command": "ftgRefs.localizeDecisionFromCursor",
        "key": "ctrl+alt+shift+d",
        "when": "editorTextFocus && editorLangId == ftg"
      },
      {
        "command": "ftgRefs.jumpBetweenSourceAndLocalization",
        "key": "ctrl+alt+shift+j",
        "when": "editorTextFocus"
      }
    ],
    "submenus": [
      {
        "id": "ftg.submenu",
        "label": "FTG Toolkit v0.3.9"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "ftg.submenu",
          "when": "editorTextFocus",
          "group": "navigation@9"
        }
      ],
      "ftg.submenu": [
        {
          "command": "ftgRefs.showReferencesFromCursor",
          "when": "editorTextFocus && editorLangId == ftg",
          "group": "1_refs@1"
        },
        {
          "command": "ftgRefs.goToDefinitionFromCursor",
          "when": "editorTextFocus && editorLangId == ftg",
          "group": "1_refs@2"
        },
        {
          "command": "ftgRefs.localizeEventFromCursor",
          "when": "editorTextFocus && editorLangId == ftg",
          "group": "2_localize@1"
        },
        {
          "command": "ftgRefs.localizeDecisionFromCursor",
          "when": "editorTextFocus",
          "group": "2_localize@2"
        },
        {
          "command": "ftgRefs.jumpBetweenSourceAndLocalization",
          "when": "editorTextFocus",
          "group": "2_localize@3"
        },
        {
          "command": "ftgRefs.insertProvinceIdFromCascade",
          "when": "editorTextFocus && editorLangId == ftg",
          "group": "3_tools@1"
        },
        {
          "command": "ftgRefs.formatDocument",
          "when": "editorTextFocus && editorLangId == ftg",
          "group": "3_tools@2"
        },
        {
          "command": "ftgRefs.scanAllProblems",
          "when": "editorTextFocus",
          "group": "3_tools@3"
        },
        {
          "command": "ftgRefs.createWorkspace",
          "group": "4_workspace@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ftgRefs.localizeEventFromCursor",
          "when": "editorLangId == ftg"
        },
        {
          "command": "ftgRefs.localizeDecisionFromCursor",
          "when": "editorTextFocus"
        },
        {
          "command": "ftgRefs.insertProvinceIdFromCascade",
          "when": "editorLangId == ftg"
        },
        {
          "command": "ftgRefs.jumpBetweenSourceAndLocalization",
          "when": "editorTextFocus"
        },
        {
          "command": "ftgRefs.formatDocument",
          "when": "editorLangId == ftg"
        },
        {
          "command": "ftgRefs.scanAllProblems"
        },
        {
          "command": "ftgRefs.createWorkspace"
        }
      ]
    },
    "configuration": {
      "title": "FTG Refs",
      "properties": {
        "ftgRefs.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Enable CodeLens for FTG IDs and flags"
        },
        "ftgRefs.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python command used to run ftg_refs.py"
        },
        "ftgRefs.scriptPath": {
          "type": "string",
          "default": "Work Folder/tools/ftg_refs.py",
          "description": "Path (relative to workspace) to ftg_refs.py"
        },
        "ftgRefs.provincesPath": {
          "type": "string",
          "default": "",
          "description": "Optional path (relative to workspace) to provinces.txt; empty = auto-detect"
        },
        "ftgRefs.enableProvinceInlayHints": {
          "type": "boolean",
          "default": true,
          "description": "Show inline province-name hints for province = <id>"
        },
        "ftgRefs.autoDetectDataFiles": {
          "type": "boolean",
          "default": true,
          "description": "Auto-detect events/monarchs/leaders/provinces files by content"
        }
      }
    }
  }
}
