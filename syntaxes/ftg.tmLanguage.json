{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "For The Glory",
  "scopeName": "source.ftg",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#dates" },
    { "include": "#months" },
    { "include": "#localizationKeys" },
    { "include": "#religionDefinitionNames" },
    { "include": "#eventFields" },
    { "include": "#religionFields" },
    { "include": "#decisionHistory" },
    { "include": "#actions" },
    { "include": "#commandTypes" },
    { "include": "#domesticSliders" },
    { "include": "#triggerTypes" },
    { "include": "#logicalBlocks" },
    { "include": "#valueAssignments" },
    { "include": "#flags" },
    { "include": "#logic" },
    { "include": "#specialValues" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#booleans" },
    { "include": "#tags" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ftg",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ftg",
          "begin": "\"",
          "end": "\""
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.ftg",
          "match": "(?<![A-Za-z_])-?\\d+(?:\\.\\d+)?(?![A-Za-z_])"
        }
      ]
    },
    "dates": {
      "patterns": [
        {
          "name": "constant.numeric.date.ftg",
          "match": "\\b(?:year|month|day)\\s*=\\s*\\d+\\b"
        }
      ]
    },
    "months": {
      "patterns": [
        {
          "name": "constant.language.month.ftg",
          "match": "\\b(?:january|february|march|april|may|june|july|august|september|october|november|december)\\b"
        }
      ]
    },
    "localizationKeys": {
      "patterns": [
        {
          "name": "entity.name.constant.localization.ftg",
          "match": "\\b(?:EVENTNAME|EVENTHIST|ACTIONNAME)\\d+[A-Z]?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.ftg",
          "match": "="
        },
        {
          "name": "punctuation.section.block.begin.ftg",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.ftg",
          "match": "\\}"
        }
      ]
    },
    "logic": {
      "patterns": [
        {
          "name": "keyword.control.logical.ftg",
          "match": "\\b(?:AND|OR|NOT|someof)\\b"
        }
      ]
    },
    "domesticSliders": {
      "patterns": [
        {
          "name": "support.type.trigger.ftg",
          "match": "\\b(?i:aristocracy|centralization|innovative|mercantilism|land|offensive|quality|serfdom)\\b"
        }
      ]
    },
    "logicalBlocks": {
      "patterns": [
        {
          "name": "meta.block.logical.ftg",
          "begin": "\\b(AND|OR|NOT|someof)\\b\\s*=\\s*\\{",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.logical.ftg"
            }
          },
          "end": "\\}",
          "patterns": [
            {
              "include": "#bracedExpression"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#eventFields"
            },
            {
              "include": "#actions"
            },
            {
              "include": "#triggerTypes"
            },
            {
              "include": "#logicalBlocks"
            },
            {
              "include": "#valueAssignments"
            },
            {
              "include": "#commandTypes"
            },
            {
              "include": "#flags"
            },
            {
              "include": "#logicalBlocks"
            },
            {
              "include": "#logic"
            },
            {
              "include": "#booleans"
            },
            {
              "include": "#specialValues"
            },
            {
              "include": "#dates"
            },
            {
              "include": "#months"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#tags"
            }
          ]
        }
      ]
    },
    "bracedExpression": {
      "patterns": [
        {
          "name": "meta.block.braced.ftg",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#eventFields"
            },
            {
              "include": "#actions"
            },
            {
              "include": "#triggerTypes"
            },
            {
              "include": "#valueAssignments"
            },
            {
              "include": "#commandTypes"
            },
            {
              "include": "#flags"
            },
            {
              "include": "#logicalBlocks"
            },
            {
              "include": "#logic"
            },
            {
              "include": "#booleans"
            },
            {
              "include": "#specialValues"
            },
            {
              "include": "#dates"
            },
            {
              "include": "#months"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#tags"
            },
            {
              "include": "#bracedExpression"
            }
          ]
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.ftg",
          "match": "\\b(?:yes|no|YES|NO)\\b"
        }
      ]
    },
    "specialValues": {
      "patterns": [
        {
          "name": "constant.language.special.ftg",
          "match": "\\b(?:random|capital|last_random|random_distinct|random_not_capital|this|overlord|emperor|random_elector|random_distinct_elector|-1|-2|-3|-4|-5|-6)\\b"
        }
      ]
    },
    "flags": {
      "patterns": [
        {
          "name": "variable.other.flag.ftg",
          "match": "\\[[A-Za-z0-9_]+\\]"
        },
        {
          "name": "meta.assignment.trigger-flag.ftg",
          "match": "\\b(flag)\\s*=\\s*([A-Za-z0-9_]+)",
          "captures": {
            "1": {
              "name": "support.type.trigger.ftg"
            },
            "2": {
              "name": "variable.other.flag.ftg"
            }
          }
        },
        {
          "name": "meta.assignment.flag.ftg",
          "match": "\\btype\\s*=\\s*(setflag|clrflag)\\b[^\\n\\r}]*\\bwhich\\s*=\\s*([A-Za-z0-9_]+)",
          "captures": {
            "1": {
              "name": "support.function.command.ftg"
            },
            "2": {
              "name": "variable.other.flag.ftg"
            }
          }
        }
      ]
    },
    "tags": {
      "patterns": [
        {
          "name": "entity.name.type.country-tag.ftg",
          "match": "\\b(?!AND\\b|NOT\\b)[A-Z][A-Z0-9]{2}\\b"
        }
      ]
    },
    "eventFields": {
      "patterns": [
        {
          "name": "keyword.control.structure.ftg",
          "match": "\\b(?:event|decision|trigger|potential|ai_trigger|date|startdate|enddate|offset|deathdate|name|desc|style|picture|persistent|major|unique|decisionhistory|random|ai_chance|id|country|province|data|command|type|which|value|monarch|action|action_a|action_b|action_c|action_d|action_e|historicalmonarch|historicalleader|dormant|category|rank|fire|shock|siege|movement|location|remark|special|techgroup)\\b"
        }
      ]
    },
    "eventDefinitionIds": {
      "patterns": [
        {
          "name": "meta.block.event.definition.ftg",
          "begin": "(?m)^event\\s*=\\s*\\{",
          "end": "(?m)^\\s*\\}",
          "patterns": [
            {
              "name": "meta.assignment.event-id.ftg",
              "match": "(?m)^(\\s*id\\s*=\\s*)(\\d+)\\b",
              "captures": {
                "1": {
                  "name": "keyword.control.structure.ftg"
                },
                "2": {
                  "name": "constant.numeric.event-definition-id.ftg"
                }
              }
            },
            {
              "include": "#eventFields"
            },
            {
              "include": "#actions"
            },
            {
              "include": "#triggerTypes"
            },
            {
              "include": "#logicalBlocks"
            },
            {
              "include": "#valueAssignments"
            },
            {
              "include": "#commandTypes"
            },
            {
              "include": "#flags"
            },
            {
              "include": "#logic"
            },
            {
              "include": "#booleans"
            },
            {
              "include": "#specialValues"
            },
            {
              "include": "#dates"
            },
            {
              "include": "#months"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#tags"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            }
          ]
        }
      ]
    },
    "decisionDefinitionIds": {
      "patterns": [
        {
          "name": "meta.block.decision.definition.ftg",
          "begin": "(?m)^decision\\s*=\\s*\\{",
          "end": "(?m)^\\s*\\}",
          "patterns": [
            {
              "name": "meta.assignment.decision-id.ftg",
              "match": "(?m)^(\\s*id\\s*=\\s*)(\\d+)\\b",
              "captures": {
                "1": {
                  "name": "keyword.control.structure.ftg"
                },
                "2": {
                  "name": "constant.numeric.decision-definition-id.ftg"
                }
              }
            },
            {
              "include": "#eventFields"
            },
            {
              "include": "#actions"
            },
            {
              "include": "#triggerTypes"
            },
            {
              "include": "#valueAssignments"
            },
            {
              "include": "#commandTypes"
            },
            {
              "include": "#flags"
            },
            {
              "include": "#logic"
            },
            {
              "include": "#booleans"
            },
            {
              "include": "#specialValues"
            },
            {
              "include": "#dates"
            },
            {
              "include": "#months"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#tags"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            }
          ]
        }
      ]
    },
    "decisionHistory": {
      "patterns": [
        {
          "name": "entity.name.section.decisionhistory.ftg",
          "match": "\\bdecisionhistory\\b"
        },
        {
          "name": "meta.block.decisionhistory.ids.ftg",
          "begin": "(?m)^\\s*(?:unique|(?!(?:AND|NOT)\\b)[A-Z]{3})\\s*=\\s*\\{",
          "end": "\\}",
          "patterns": [
            {
              "name": "constant.numeric.decision-id.ftg",
              "match": "\\b\\d+\\b"
            },
            {
              "include": "#comments"
            }
          ]
        },
        {
          "name": "keyword.control.special.decisionhistory.ftg",
          "match": "(?m)^\\s*unique(?=\\s*=\\s*\\{)"
        },
        {
          "name": "entity.name.type.country-tag.decisionhistory.ftg",
          "match": "(?m)^\\s*(?!(?:AND|NOT)\\b)[A-Z]{3}(?=\\s*=\\s*\\{)"
        }
      ]
    },
    "actions": {
      "patterns": [
        {
          "name": "entity.name.section.action.ftg",
          "match": "\\baction(?:_[a-z])?\\b"
        }
      ]
    },
    "commandTypes": {
      "patterns": [
        {
          "name": "support.function.command.ftg",
          "match": "\\b(?:alliance|dynastic|vassal|breakvassal|breakoverlord|inherit|annex|independence|relation|casusbelli|war|peace|cedeprovince|secedeprovince|control|giveaccess|cancelaccess|revokeaccess|givetrade|revoketrade|elector|flagname|countryname|wakemonarch|sleepmonarch|wakeleader|sleepleader|conquistador|explorer|ADM|MIL|DIP|country|technology|religion|add_countryculture|remove_countryculture|manpower|badboy|capital|addcore|addcore_national|addcore_claim|addcore_casusbelli|removecore_national|removecore_claim|removecore_casusbelli|domestic|land|naval|stability|trade|infra|treasury|inflation|loansize|population|populationpercent|tax|provincetax|provincemanpower|manufactory|fortress|provincereligion|provinceculture|cityculture|alt_provincereligion|goods|terrain|conversion|heretic|hre|cot|removecot|mine|natives|nativeattack|revolt|province_revoltrisk|colonialrevolt|religiousrevolt|revoltrisk|gainbuilding|losebuilding|gainmanufactory|losemanufactory|fortresslevel|diplomats|colonists|merchants|missionaries|INF|CAV|ART|desertion|ai|setflag|clrflag|flag|sleepevent|trigger|vp|cash)\\b"
        }
      ]
    },
    "valueAssignments": {
      "patterns": [
        {
          "name": "meta.assignment.religion.ftg",
          "match": "\\b(religion)\\s*=\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.structure.ftg"
            },
            "2": {
              "name": "constant.language.religion.ftg"
            }
          }
        },
        {
          "name": "meta.assignment.domestic-which.ftg",
          "match": "\\b(type)\\s*=\\s*(domestic)\\b[^\\n\\r}]*\\b(which)\\s*=\\s*((?i:aristocracy|centralization|innovative|mercantilism|land|offensive|quality|serfdom))\\b",
          "captures": {
            "1": {
              "name": "keyword.control.structure.ftg"
            },
            "2": {
              "name": "support.function.command.ftg"
            },
            "3": {
              "name": "keyword.control.structure.ftg"
            },
            "4": {
              "name": "support.type.trigger.ftg"
            }
          }
        },
        {
          "name": "meta.assignment.relation-which.ftg",
          "match": "\\b(type)\\s*=\\s*(relation)\\b[^\\n\\r}]*\\b(which)\\s*=\\s*([A-Z0-9]{3})",
          "captures": {
            "1": {
              "name": "keyword.control.structure.ftg"
            },
            "2": {
              "name": "support.function.command.ftg"
            },
            "3": {
              "name": "keyword.control.structure.ftg"
            },
            "4": {
              "name": "entity.name.type.country-tag.ftg"
            }
          }
        },
        {
          "name": "meta.assignment.trigger-provincereligion-data.ftg",
          "match": "\\b(provincereligion)\\s*=\\s*\\{[^\\n\\r}]*\\b(data)\\s*=\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "support.type.trigger.ftg"
            },
            "2": {
              "name": "keyword.control.structure.ftg"
            },
            "3": {
              "name": "constant.language.religion.ftg"
            }
          }
        }
      ]
    },
    "triggerTypes": {
      "patterns": [
        {
          "name": "support.type.trigger.ftg",
          "match": "\\b(?:alliance|dynastic|vassal|union|war|truce|atwar|isvassal|ai|event|decision|flag|exists|year|month|day|someof|random|badboy|inflation|treasury|diplomats|merchants|colonists|missionaries|elector|emperor|hre|neighbour|tag|domestic|land|naval|stability|trade|infra|capital|countrysize|core_national|core_claim|core_casusbelli|provinceculture|cityculture|provincereligion|owned|control|ownerchange|controlchange|discovered|cot|fortresslevel|provincepopulation|tradingpost|colony|colonialcity|city|relation|bankrupt|revolt|occupied|manpower)\\b"
        }
      ]
    },
    "religionDefinitionNames": {
      "patterns": [
        {
          "name": "meta.definition.religion.ftg",
          "match": "(?m)^([a-z][a-z_0-9]*)\\s*=\\s*\\{",
          "captures": {
            "1": {
              "name": "entity.name.type.religion-def.ftg"
            }
          }
        }
      ]
    },
    "religionFields": {
      "patterns": [
        {
          "name": "keyword.control.religion-field.ftg",
          "match": "\\b(?:group|subgroup|color|allowed_conversion|income_bonus|aggressiveness|conflict|papacy|predominance|force_conversion|defender|annexable|annex_same_penalty|annex_other_penalty|tech_speed|stability_bonus|stability_cost|missionary_placement_chance|missionary_placement_penalty|missionary_sprite|land_morale|naval_morale|trade_efficiency|production_efficiency|global_tax_modifier|slaves_effect|reveal_map|whiteman|defectprovinceto_penalty|province_nationalism|province_religion|coastalprovince_bonus)\\b"
        }
      ]
    }
  }
}
